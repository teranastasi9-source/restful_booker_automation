# Base URL for API Restful Booker
BASE_URL=https://restful-booker.herokuapp.com
# Mock Server for API Restful Booker
MOCK_URL=https://b46c2b66-2cdd-4ff5-abb5-388678ae176d.mock.pstmn.io
# Username for authentication (Public)
USER=admin
# Password for authentication (Public)
