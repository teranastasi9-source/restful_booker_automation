# Maximum acceptable response time in milliseconds
MAX_RESPONSE_TIME=1500
# Socket-level timeout (seconds) for each HTTP request, so a hung connection to the live API
# fails fast instead of blocking a test indefinitely
REQUEST_TIMEOUT=10
